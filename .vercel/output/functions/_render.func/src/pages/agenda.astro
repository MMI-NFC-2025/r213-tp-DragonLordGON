---
import Layout from '../layouts/Layout.astro';

const events = [
    {
        title: "Conférence sur les astres",
        date: "Lundi 12 Juillet",
        favori: true,
    },
    {
        title: "Atelier sur les étoiles",
        date: "Mardi 13 Juillet",
        favori: false,
    },
];
---

{
    events.map((event) => (
        <ul>
            <li>{event.title} - {event.date}</li>
        </ul>
    ))
}

