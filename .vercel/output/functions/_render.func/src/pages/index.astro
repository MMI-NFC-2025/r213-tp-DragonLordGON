---
import Layout from '../layouts/Layout.astro'
import { allMaisonsFavori } from '../js/backend.mjs';
import OffreCard from '../components/OffreCard.astro';

const favoris = await allMaisonsFavori();
---

<Layout titre="Accueil">
    <h1>Accueil</h1>
	<h2>Bienvenue sur mon site !</h2>
    
    <section>
        <h3 class="text-2xl font-bold my-4">Mes maisons favorites</h3>
        <div class="flex overflow-x-auto gap-4 p-4 scrollbar-hide">
            {favoris.length > 0 ? (
                favoris.map((offre) => (
                    <div class="flex-none w-80">
                        <OffreCard offre={offre} />
                    </div>
                ))
            ) : (
                <p>Aucune maison favorite pour le moment.</p>
            )}
        </div>
    </section>
</Layout>
