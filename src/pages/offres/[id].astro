---
import { OneID } from '../../js/backend.mjs';
import Layout  from '../../layouts/Layout.astro';

const { id } = Astro.params;
const offre = await OneID   (id);
---

<Layout titre={offre.nomMaison}>
    <h2>{offre.nomMaison}</offre>
    <ul>
        <li>{offre.adresse}</li>
        <li>{offre.prix}€</li>
        <li>{offre.surface}m²</li>
    </ul>
</Layout>
