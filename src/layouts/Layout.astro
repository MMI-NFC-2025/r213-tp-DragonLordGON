---
import EventCard from '../components/EventCard.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';

const { titre } = Astro.props;
const events = [
    {
        title: "Conférence sur les astres",
        date: "Lundi 12 Juillet",
        favori: true,
    },
    {
        title: "Atelier sur les étoiles",
        date: "Mardi 13 Juillet",
        favori: false,
    },
];
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<title> {titre} </title>
    </head>
    <body class="bg-amber-50">
        <Header/>
        <main class="justify-center items-center m-70 text-7xl text-gray-800 font-bold">
            <slot />
        </main>
        <Footer/>
    </body>
</html>

<Layout title="Agenda">
    <h1>Event Agenda</h1>
    <ul>
        {
            events.map((ev) => (
                <EventCard event={ev} />
            ))
        }
    </ul>